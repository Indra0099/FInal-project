# Local college demonstration only. Replace passwords before any shared deployment.
DB_PASSWORD=local-shard-admin-change-me
READER_PASSWORD=local-readonly-change-me
APP_PASSWORD=local-metadata-change-me
# Use your personal Google AI Studio project marked Free Tier, with billing disabled.
# The application cannot determine your account's billing status. No paid-provider fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
WORKSPACE_PASSWORD=local-workspaces-change-me
# Use true only when serving the app over HTTPS. Local HTTP requires false.
COOKIE_SECURE=false
APP_PORT=8087

# Exact PostgreSQL hostnames allowed for saved connections (comma-separated, no wildcards).
EXTERNAL_DB_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
