{
  "info": {
    "name": "ShardQuery database management examples (manual)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Optional manual requests, not a sequential test run. Sign in with the existing auth collection and obtain a fresh CSRF token in the same cookie jar. Set IDs only for disposable fixtures. Keep postgresConnectionUrl in a private local secret variable; never export it. Destructive requests require the selected name. The separate OpenAPI contract is authoritative."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8087/api"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "databaseId",
      "value": ""
    },
    {
      "key": "tableId",
      "value": ""
    },
    {
      "key": "connectionId",
      "value": ""
    },
    {
      "key": "connectionName",
      "value": "External college"
    },
    {
      "key": "postgresConnectionUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Rename selected local database",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Renamed practice\"\n}"
        },
        "url": "{{baseUrl}}/databases/{{databaseId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Add optional column",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"department\",\n  \"type\": \"TEXT\",\n  \"required\": false\n}"
        },
        "url": "{{baseUrl}}/databases/{{databaseId}}/tables/{{tableId}}/columns"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Rename local column",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"department_name\"\n}"
        },
        "url": "{{baseUrl}}/databases/{{databaseId}}/tables/{{tableId}}/columns/department"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete selected column after explicit confirmation",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"confirmation\": \"department_name\"\n}"
        },
        "url": "{{baseUrl}}/databases/{{databaseId}}/tables/{{tableId}}/columns/department_name"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Connect PostgreSQL with a private local variable",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{connectionName}}\",\n  \"connectionUrl\": \"{{postgresConnectionUrl}}\",\n  \"schema\": \"public\"\n}"
        },
        "url": "{{baseUrl}}/databases/connect"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh selected connection",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{baseUrl}}/databases/{{connectionId}}/refresh"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Disconnect selected connection",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"confirmation\": \"{{connectionName}}\"\n}"
        },
        "url": "{{baseUrl}}/databases/{{connectionId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
